++    letterSpacing: 1.5,
++    textTransform: "uppercase",
++    marginBottom: 2,
++  },
++  memoryCard: {
++    flexDirection: "row",
++    alignItems: "flex-start",
++    gap: spacing.md,
++    backgroundColor: colors.surface1,
++    borderRadius: radii.lg,
