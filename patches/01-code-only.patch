@@ -0,0 +1,1157 @@
+"""Master boundary + key-verse table for canonical-web-v1.
+
+Each ENTRY tuple:
+    (book, start_ch, start_v, end_ch, end_v,
+     kv_ch, kv_v, kv_end_v_or_None,
+     editorial_note_or_None)
